{
  "schema": 1,
  "repository": "alecerf/mynou",
  "default_branch": "trunk",
  "control_branch": "control/engineering",
  "state_path": "state.json",
  "max_active_agents": 1,
  "lease_minutes": 45,
  "heartbeat_minutes": 15,
  "slice_minutes": 40,
  "no_progress_limit": 3,
  "trusted_reviewers": [
    "alecerf"
  ],
  "project": null,
  "required_workflows": {
    "Mynou CI": [
      "validate",
      "Build x86_64-unknown-linux-gnu",
      "Build x86_64-unknown-linux-musl",
      "Build aarch64-apple-darwin",
      "Build x86_64-apple-darwin",
      "package"
    ],
    "Engineering checks": [
      "organization"
    ]
  },
  "observed_capabilities": {
    "observed_at": "2026-10-06",
    "issues": true,
    "native_dependencies": true,
    "issue_type_assignment": false,
    "projects_write": false,
    "rulesets": false,
    "branch_protection_admin": false,
    "auto_merge_configuration": false,
    "code_scanning": false,
    "secret_scanning_admin": false,
    "git_https_push": false,
    "git_data_api_write": true,
    "scheduled_tasks_tool": true,
    "quota_introspection": false,
    "guaranteed_quota_reset_wake": false
  },
  "control_ref": "refs/heads/control/engineering"
}
